---
import Layout from '../layouts/Layout.astro';
import VendorDirectory from '../components/VendorDirectory.astro';
import { VENDORS } from '../data/vendors';
---

<Layout 
  title="Complete CSV / CSA Vendor Directory | Saram Consulting"
  description="Searchable directory of all 20+ tracked computerized systems validation and software assurance platforms across all 4 tiers."
  activePath="/vendors"
>
  <main>
    <section class="hero-text">
      <h1>Validation Vendor Directory</h1>
      <p class="hero-subtitle">Comprehensive Index of Pure-Play, Adjacent, Specialist, and Legacy Systems</p>
      <p>
        Filter and search across {VENDORS.length} tracked platforms in our verified validation knowledge bank. Search by company name, enterprise customers (e.g. AstraZeneca, Biogen, Pfizer, Novartis), AI capabilities, or system category.
      </p>
    </section>

    <section>
      <VendorDirectory />
    </section>
  </main>
</Layout>
