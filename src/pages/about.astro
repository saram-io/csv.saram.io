---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://csv.saram.io/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About & Research Methodology",
      "item": "https://csv.saram.io/about/"
    }
  ]
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About csv.saram.io & Research Methodology",
  "description": "Research methodology, live verification protocols, and advisory services from Saram Consulting.",
  "url": "https://csv.saram.io/about/",
  "publisher": {
    "@type": "Organization",
    "name": "Saram Consulting",
    "url": "https://saram.io"
  }
};
---

<Layout 
  title="About & Research Methodology: Independent CSV/CSA Intelligence | Saram Consulting"
  description="Research methodology, live verification protocols, and life sciences advisory services from Saram Consulting."
  activePath="/about"
  schemas={[breadcrumbSchema, aboutPageSchema]}
>
  <main>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: 12px; margin-bottom: 20px; color: var(--muted-text);">
      <a href="/" style="color: inherit; text-decoration: underline;">Home</a>
      <span style="margin: 0 6px;">&rsaquo;</span>
      <span style="color: #000; font-weight: 600;">About & Methodology</span>
    </nav>
    <section class="hero-text">
      <h1>Research Methodology & About Saram</h1>
      <p class="hero-subtitle">Independent GxP & AI Technical Intelligence for Regulated Life Sciences</p>
      <p>
        <strong>csv.saram.io</strong> is an independent research publication maintained by <a href="https://saram.io" target="_blank" rel="noopener" class="service-link">Saram Consulting</a>. Our mission is to provide life science leaders, QA directors, and validation professionals with transparent, technically rigorous intelligence on computerized system validation and software assurance technologies.
      </p>
    </section>

    <!-- Methodology -->
    <section>
      <h2 class="section-title">Research Methodology & Verification</h2>
      <div class="callout-box">
        <h3 style="margin-bottom: 8px;">Durable Knowledge Bank & Live Verification Standards</h3>
        <p>
          Unlike generic analyst reports that rely on vendor-sponsored positioning, our research is anchored in empirical technical analysis, direct customer implementations, and verified public disclosures:
        </p>
        <ul style="padding-left: 20px; font-size: 13px; line-height: 1.7; margin-top: 8px;">
          <li>
            <strong>HTTP & Live System Verification:</strong> All tracked platforms are continuously audited via automated HTTP crawls to verify active software availability, documentation, and product changes (Current benchmark verified live: 2026-06-13).
          </li>
          <li>
            <strong>Verified Corporate Transactions:</strong> Corporate events—such as Thoma Bravo's definitive acquisition of Kneat Gx and ValGenesis's $16M strategic financing—are verified against regulatory filings, press releases, and TSE/SEC records.
          </li>
          <li>
            <strong>Direct Technical Audits:</strong> Features such as ValGenesis's VAL™ agent launch at INTERPHEX (April 14, 2026), Veeva's Vault MCP Server (GA 26R2, August 2026), and MasterControl's ISO/IEC 42001 certification (July 15, 2025) are verified directly from vendor technical documentation and certification bodies.
          </li>
          <li>
            <strong>Regulatory Cross-Referencing:</strong> Every classification is analyzed against FDA 21 CFR Part 11, the FDA draft guidance on Computer Software Assurance (CSA), and ISPE GAMP 5 Second Edition.
          </li>
        </ul>
      </div>
    </section>

    <!-- About Saram Consulting -->
    <section>
      <h2 class="section-title">About Saram Consulting</h2>
      <p>
        Saram Consulting bridges the gap between cutting-edge artificial intelligence and rigorous regulatory compliance. We help life science companies safely integrate AI into their business workflows while maintaining strict GxP compliance and providing comprehensive IT support.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin: 16px 0;">
        <div style="background: var(--card-bg); padding: 16px; border-radius: 6px; border: 1px solid var(--card-border);">
          <strong style="font-family: var(--font-serif); font-size: 15px;">Vendor Selection & Benchmark</strong>
          <p style="font-size: 12.5px; margin-top: 6px; color: #222;">
            Independent evaluation and RFP management for Tier 1 and Tier 3 validation systems (Kneat vs. ValGenesis vs. Veeva Vault vs. GoVal) aligned with your IT infrastructure.
          </p>
        </div>

        <div style="background: var(--card-bg); padding: 16px; border-radius: 6px; border: 1px solid var(--card-border);">
          <strong style="font-family: var(--font-serif); font-size: 15px;">CSV-to-CSA Transformation</strong>
          <p style="font-size: 12.5px; margin-top: 6px; color: #222;">
            Transitioning legacy validation master plans, SOPs, and test protocols to the FDA's risk-based Computer Software Assurance paradigm, slashing documentation time by up to 60%.
          </p>
        </div>

        <div style="background: var(--card-bg); padding: 16px; border-radius: 6px; border: 1px solid var(--card-border);">
          <strong style="font-family: var(--font-serif); font-size: 15px;">Validated AI Software Engineering</strong>
          <p style="font-size: 12.5px; margin-top: 6px; color: #222;">
            Building custom multi-agent compliance systems, automated deviation summarizers, and Part 11 audit trails with zero-trust verification pipelines.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Details -->
    <section>
      <h2 class="section-title">Contact & Engagement</h2>
      <p>
        To discuss vendor benchmarking, request a validation architecture review, or suggest additions to our research database:
      </p>
      <p>
        <strong>Email:</strong> <a href="mailto:info@saram.consulting" class="service-link">info@saram.consulting</a><br />
        <strong>Phone:</strong> <a href="tel:+19253946606" class="service-link">925-394-6606</a><br />
        <strong>Main Website:</strong> <a href="https://saram.io" target="_blank" rel="noopener" class="service-link">saram.io &rarr;</a><br />
        <strong>Product Spotlight:</strong> <a href="https://gxpchat.com" target="_blank" rel="noopener" class="service-link">GxPChat.com &rarr;</a>
      </p>
    </section>
  </main>
</Layout>
