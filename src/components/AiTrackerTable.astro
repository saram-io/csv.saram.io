---
import { AI_TRACKER_DATA, getAiTrackerStats } from '../data/aiTrackerData';

const stats = getAiTrackerStats();
const openCount = AI_TRACKER_DATA.filter(v => v.walledGardenPosture === 'Open Protocol Pioneer').length;
const proprietaryCount = AI_TRACKER_DATA.filter(v => v.walledGardenPosture === 'Proprietary AI Moat').length;
const ecosystemCount = AI_TRACKER_DATA.filter(v => v.walledGardenPosture === 'Ecosystem Walled Garden').length;
const gatedCount = AI_TRACKER_DATA.filter(v => v.walledGardenPosture === 'API Gated / Restricted').length;
const closedCount = AI_TRACKER_DATA.filter(v => v.walledGardenPosture === 'Closed Fortress').length;
---

<div class="ai-tracker-wrapper">
  <!-- Top Stat KPI Cards -->
  <div class="tracker-kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">Tracked CSV Vendors</div>
      <div class="kpi-value">{stats.total}</div>
      <div class="kpi-sub">Audited across Tiers 1–4</div>
    </div>
    
    <div class="kpi-card kpi-success">
      <div class="kpi-label">Open Protocol Pioneers</div>
      <div class="kpi-value">{stats.openPct}%</div>
      <div class="kpi-sub">{stats.openCount} of {stats.total} vendors</div>
    </div>

    <div class="kpi-card kpi-accent">
      <div class="kpi-label">MCP Server Ready</div>
      <div class="kpi-value">{stats.mcpShippedPct}%</div>
      <div class="kpi-sub">{stats.mcpShippedCount} vendors GA or in Dev</div>
    </div>

    <div class="kpi-card kpi-warning">
      <div class="kpi-label">Proprietary Moats & Silos</div>
      <div class="kpi-value">{stats.proprietaryMoatPct}%</div>
      <div class="kpi-sub">{stats.proprietaryMoatCount} locked walled gardens</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label">Avg Openness Index</div>
      <div class="kpi-value">{stats.avgScore}<span style="font-size: 14px; font-weight: normal; color: var(--muted-text);">/100</span></div>
      <div class="kpi-sub">Composite 100-pt benchmark</div>
    </div>
  </div>

  <!-- Filter & Controls Toolbar -->
  <div class="tracker-toolbar">
    <div class="search-row">
      <input 
        type="text" 
        id="aiTrackerSearch" 
        class="search-input" 
        aria-label="Filter vendors by protocol, BYO-AI stance, or lock-in risk"
        placeholder="Filter by vendor, protocol (MCP, REST, GraphQL), BYO-AI stance, or lock-in risk..." 
      />
      <div class="view-switchers">
        <button class="view-btn active" id="viewMatrixBtn" type="button" title="Comparison Matrix View">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3zM3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
          Matrix View
        </button>
        <button class="view-btn" id="viewCardsBtn" type="button" title="Detailed Dossier Cards View">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Dossier View
        </button>
      </div>
    </div>

    <!-- Filter Pills Row 1: Walled Garden Posture -->
    <div class="filter-group-row">
      <span class="group-label">Walled Garden Posture:</span>
      <div class="pill-group" id="postureFilters">
        <button class="filter-pill active" data-filter-posture="all">All ({AI_TRACKER_DATA.length})</button>
        <button class="filter-pill" data-filter-posture="Open Protocol Pioneer">Open Pioneer ({openCount})</button>
        <button class="filter-pill" data-filter-posture="Proprietary AI Moat">Proprietary Moat ({proprietaryCount})</button>
        <button class="filter-pill" data-filter-posture="Ecosystem Walled Garden">Ecosystem Bound ({ecosystemCount})</button>
        <button class="filter-pill" data-filter-posture="API Gated / Restricted">API Gated ({gatedCount})</button>
        <button class="filter-pill" data-filter-posture="Closed Fortress">Closed Fortress ({closedCount})</button>
      </div>
    </div>

    <!-- Filter Pills Row 2: MCP Status & Sorting -->
    <div class="filter-group-row" style="margin-top: 8px;">
      <span class="group-label">Model Context Protocol (MCP):</span>
      <div class="pill-group" id="mcpFilters">
        <button class="filter-pill active" data-filter-mcp="all">All</button>
        <button class="filter-pill" data-filter-mcp="GA Native MCP Server">GA Native MCP</button>
        <button class="filter-pill" data-filter-mcp="Roadmap / In Dev">Roadmap / In Dev</button>
        <button class="filter-pill" data-filter-mcp="Proprietary Only (No MCP)">Proprietary Only</button>
        <button class="filter-pill" data-filter-mcp="Ecosystem Bound">Ecosystem Bound</button>
        <button class="filter-pill" data-filter-mcp="None / Unsupported">None / Legacy</button>
      </div>

      <div class="sort-wrapper">
        <label for="trackerSortSelect" class="sort-label">Sort:</label>
        <select id="trackerSortSelect" class="sort-select">
          <option value="score-desc">Score: High to Low</option>
          <option value="score-asc">Score: Low to High</option>
          <option value="name-asc">Vendor Name (A-Z)</option>
          <option value="tier-asc">Market Tier (1 to 4)</option>
        </select>
      </div>
    </div>

    <div class="results-meta-bar">
      <span id="trackerResultsCounter">Showing {AI_TRACKER_DATA.length} of {AI_TRACKER_DATA.length} evaluated CSV vendors</span>
      <span id="trackerFilterStatus">Active: All vendors</span>
    </div>
  </div>

  <!-- VIEW 1: MATRIX TABLE VIEW -->
  <div id="trackerMatrixView" class="tracker-view-container">
    <div class="table-wrapper">
      <table class="tracker-matrix-table" id="aiTrackerTable">
        <thead>
          <tr>
            <th style="min-width: 170px;">Vendor & Product</th>
            <th style="min-width: 130px;">Walled Garden Posture</th>
            <th style="min-width: 115px;">Score (out of 100)</th>
            <th style="min-width: 140px;">MCP Support</th>
            <th style="min-width: 150px;">API & Webhooks</th>
            <th style="min-width: 125px;">BYO-AI Stance</th>
            <th style="min-width: 135px;">Part 11 AI Audit</th>
            <th style="min-width: 105px;">Lock-in Risk</th>
            <th style="min-width: 90px; text-align: center;">Details</th>
          </tr>
        </thead>
        <tbody id="trackerTableBody">
          {AI_TRACKER_DATA.map((entry) => {
            const postureClass = 
              entry.walledGardenPosture === 'Open Protocol Pioneer' ? 'badge-open' :
              entry.walledGardenPosture === 'Proprietary AI Moat' ? 'badge-silo' :
              entry.walledGardenPosture === 'Ecosystem Walled Garden' ? 'badge-selective' :
              entry.walledGardenPosture === 'API Gated / Restricted' ? 'badge-gated' : 'badge-legacy';

            const mcpClass = 
              entry.mcpStatus === 'GA Native MCP Server' ? 'badge-mcp-ga' :
              entry.mcpStatus === 'Roadmap / In Dev' ? 'badge-mcp-beta' :
              entry.mcpStatus === 'Proprietary Only (No MCP)' ? 'badge-mcp-none' :
              entry.mcpStatus === 'Ecosystem Bound' ? 'badge-mcp-roadmap' : 'badge-muted';

            const scoreColor = 
              entry.readinessScore >= 80 ? '#1b5e20' :
              entry.readinessScore >= 65 ? '#2e7d32' :
              entry.readinessScore >= 50 ? '#b26a00' : '#c62828';

            const moatColor = 
              entry.commercialMoatRisk.startsWith('Low') ? '#1b5e20' :
              entry.commercialMoatRisk.startsWith('Medium') ? '#b26a00' : '#c62828';

            const gradeClass = 
              entry.opennessGrade === 'A+' || entry.opennessGrade === 'A' ? 'grade-a' :
              entry.opennessGrade === 'B' ? 'grade-b' :
              entry.opennessGrade === 'C' ? 'grade-c' : 'grade-low';

            return (
              <>
                <tr 
                  class="tracker-row" 
                  data-id={entry.vendorId}
                  data-tier={entry.tier}
                  data-score={entry.readinessScore}
                  data-name={entry.vendorName.toLowerCase()}
                  data-posture={entry.walledGardenPosture}
                  data-mcp={entry.mcpStatus}
                  data-search={`${entry.vendorName} ${entry.product} ${entry.walledGardenPosture} ${entry.mcpStatus} ${entry.mcpDetails} ${entry.apiOpenness} ${entry.apiDetails} ${entry.byoAiPolicy} ${entry.walledGardenAnalysis} ${entry.buyerTakeaway}`.toLowerCase()}
                >
                  <td>
                    <strong class="vendor-title-link">
                      <a href={`/vendors/${entry.vendorId}/`}>{entry.vendorName}</a>
                    </strong>
                    {entry.ticker && <span class="vendor-ticker">{entry.ticker}</span>}
                    <div class="product-subtitle">{entry.product}</div>
                    <span class="tier-tag">T{entry.tier} — {entry.tierLabel.split('—')[1]?.trim() || ''}</span>
                  </td>
                  <td>
                    <span class={`status-badge ${postureClass}`}>{entry.walledGardenPosture}</span>
                    <div class="pricing-posture">{entry.apiPricingPosture}</div>
                  </td>
                  <td>
                    <div class="score-display">
                      <div style="display: flex; align-items: baseline; gap: 4px;">
                        <span class="score-num" style={`color: ${scoreColor};`}>{entry.readinessScore}</span>
                        <span class={`grade-pill ${gradeClass}`}>{entry.opennessGrade}</span>
                      </div>
                      <div class="score-bar-track">
                        <div class="score-bar-fill" style={`width: ${entry.readinessScore}%; background: ${scoreColor};`}></div>
                      </div>
                      <div class="score-rubric-mini">
                        MCP:{entry.scoreBreakdown.mcp} | API:{entry.scoreBreakdown.api} | Dat:{entry.scoreBreakdown.dataPortability}
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class={`status-badge ${mcpClass}`}>{entry.mcpStatus}</span>
                    <p class="matrix-cell-note">{entry.mcpDetails}</p>
                  </td>
                  <td>
                    <strong style="font-size: 11.5px; display: block;">{entry.apiOpenness.split('(')[0]}</strong>
                    <span style="font-size: 11px; color: var(--muted-text); display: block;">
                      Webhooks: {entry.webhooksSupported ? '✓ Real-time' : '✗ Polling/None'}
                    </span>
                    <p class="matrix-cell-note">{entry.apiDetails}</p>
                  </td>
                  <td>
                    <span class="text-pill">{entry.byoAiPolicy}</span>
                  </td>
                  <td>
                    <div style="font-size: 11.5px; line-height: 1.3;">{entry.part11AiAttribution}</div>
                    {entry.iso42001Status !== 'Uncertified / None' && (
                      <span class="iso-tag">ISO 42001: {entry.iso42001Status}</span>
                    )}
                  </td>
                  <td>
                    <span class="moat-risk-tag" style={`color: ${moatColor}; border-color: ${moatColor}44;`}>
                      {entry.commercialMoatRisk}
                    </span>
                  </td>
                  <td style="text-align: center;">
                    <button 
                      type="button" 
                      class="expand-btn" 
                      data-target={`details-${entry.vendorId}`}
                      aria-expanded="false"
                      title="View 100-Point Scoring Breakdown & Takeaways"
                    >
                      Audit &darr;
                    </button>
                  </td>
                </tr>
                <tr class="details-row" id={`details-${entry.vendorId}`} style="display: none;">
                  <td colspan="9" class="details-cell">
                    <div class="details-inner-grid">
                      <!-- Rubric Breakdown -->
                      <div class="rubric-card">
                        <strong class="details-heading">100-Point Rubric Breakdown:</strong>
                        <div class="rubric-bars">
                          <div class="rubric-row">
                            <span>1. Model Context Protocol (max 30):</span>
                            <strong>{entry.scoreBreakdown.mcp} / 30</strong>
                          </div>
                          <div class="rubric-row">
                            <span>2. API Openness & Webhooks (max 25):</span>
                            <strong>{entry.scoreBreakdown.api} / 25</strong>
                          </div>
                          <div class="rubric-row">
                            <span>3. Data Portability & Schemas (max 15):</span>
                            <strong>{entry.scoreBreakdown.dataPortability} / 15</strong>
                          </div>
                          <div class="rubric-row">
                            <span>4. Part 11 AI Attribution (max 15):</span>
                            <strong>{entry.scoreBreakdown.part11Audit} / 15</strong>
                          </div>
                          <div class="rubric-row">
                            <span>5. BYO-AI Freedom & Posture (max 15):</span>
                            <strong>{entry.scoreBreakdown.byoAiFreedom} / 15</strong>
                          </div>
                          <div class="rubric-total-row">
                            <span>Composite Audited Score:</span>
                            <span class="total-score-val" style={`color: ${scoreColor};`}>{entry.readinessScore} / 100 ({entry.opennessGrade})</span>
                          </div>
                        </div>
                      </div>

                      <!-- Walled Garden Analysis -->
                      <div>
                        <strong class="details-heading">Walled Garden & Data Stance:</strong>
                        <p class="details-text">{entry.walledGardenAnalysis}</p>
                      </div>

                      <!-- Buyer Takeaway -->
                      <div class="takeaway-card">
                        <strong class="takeaway-title">Procurement & Buyer Takeaway:</strong>
                        <p class="takeaway-text">{entry.buyerTakeaway}</p>
                        <div style="margin-top: 8px;">
                          <a href={`/vendors/${entry.vendorId}/`} class="vendor-deep-link">
                            View Full {entry.vendorName} CSA & Validation Profile &rarr;
                          </a>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              </>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <!-- VIEW 2: DETAILED DOSSIER CARDS VIEW -->
  <div id="trackerCardsView" class="tracker-view-container" style="display: none;">
    <div class="cards-grid" id="trackerCardsGrid">
      {AI_TRACKER_DATA.map((entry) => {
        const postureClass = 
          entry.walledGardenPosture === 'Open Protocol Pioneer' ? 'badge-open' :
          entry.walledGardenPosture === 'Proprietary AI Moat' ? 'badge-silo' :
          entry.walledGardenPosture === 'Ecosystem Walled Garden' ? 'badge-selective' :
          entry.walledGardenPosture === 'API Gated / Restricted' ? 'badge-gated' : 'badge-legacy';

        const mcpClass = 
          entry.mcpStatus === 'GA Native MCP Server' ? 'badge-mcp-ga' :
          entry.mcpStatus === 'Roadmap / In Dev' ? 'badge-mcp-beta' :
          entry.mcpStatus === 'Proprietary Only (No MCP)' ? 'badge-mcp-none' :
          entry.mcpStatus === 'Ecosystem Bound' ? 'badge-mcp-roadmap' : 'badge-muted';

        const scoreColor = 
          entry.readinessScore >= 80 ? '#1b5e20' :
          entry.readinessScore >= 65 ? '#2e7d32' :
          entry.readinessScore >= 50 ? '#b26a00' : '#c62828';

        const gradeClass = 
          entry.opennessGrade === 'A+' || entry.opennessGrade === 'A' ? 'grade-a' :
          entry.opennessGrade === 'B' ? 'grade-b' :
          entry.opennessGrade === 'C' ? 'grade-c' : 'grade-low';

        return (
          <div 
            class="card tracker-dossier-card"
            data-id={entry.vendorId}
            data-tier={entry.tier}
            data-score={entry.readinessScore}
            data-name={entry.vendorName.toLowerCase()}
            data-posture={entry.walledGardenPosture}
            data-mcp={entry.mcpStatus}
            data-search={`${entry.vendorName} ${entry.product} ${entry.walledGardenPosture} ${entry.mcpStatus} ${entry.mcpDetails} ${entry.apiOpenness} ${entry.apiDetails} ${entry.byoAiPolicy} ${entry.walledGardenAnalysis} ${entry.buyerTakeaway}`.toLowerCase()}
          >
            <div class="card-top-row">
              <div>
                <div class="card-tier-label">{entry.tierLabel}</div>
                <h3 class="vendor-name-header">
                  <a href={`/vendors/${entry.vendorId}/`}>{entry.vendorName}</a>
                  {entry.ticker && <span class="vendor-ticker">{entry.ticker}</span>}
                </h3>
                <div class="card-product-name">{entry.product}</div>
              </div>
              <div class="card-score-badge" style={`border-color: ${scoreColor};`}>
                <div style="display: flex; align-items: baseline; gap: 4px; justify-content: center;">
                  <span class="score-badge-val" style={`color: ${scoreColor};`}>{entry.readinessScore}</span>
                  <span class={`grade-pill ${gradeClass}`} style="font-size: 10px; padding: 1px 5px;">{entry.opennessGrade}</span>
                </div>
                <span class="score-badge-label">OPEN SCORE</span>
              </div>
            </div>

            <!-- Stance and Badges Strip -->
            <div class="badges-strip">
              <span class={`status-badge ${postureClass}`}>{entry.walledGardenPosture}</span>
              <span class={`status-badge ${mcpClass}`}>MCP: {entry.mcpStatus}</span>
              <span class="status-badge text-pill">{entry.byoAiPolicy}</span>
            </div>

            <!-- Saram Independent Verdict -->
            <div class="verdict-box">
              <strong class="verdict-title">Saram Independent Verdict & Data Stance:</strong>
              <p class="verdict-text">{entry.walledGardenAnalysis}</p>
            </div>

            <!-- Technical Specifications Grid -->
            <div class="tech-spec-grid">
              <div class="spec-cell">
                <span class="spec-label">
                  Model Context Protocol (MCP) 
                  <span class="spec-score-tag">{entry.scoreBreakdown.mcp}/30 pts</span>
                </span>
                <p class="spec-val">{entry.mcpDetails}</p>
              </div>

              <div class="spec-cell">
                <span class="spec-label">
                  API & Webhooks 
                  <span class="spec-score-tag">{entry.scoreBreakdown.api}/25 pts</span>
                </span>
                <p class="spec-val">
                  <strong>{entry.apiOpenness}</strong><br />
                  Webhooks: {entry.webhooksSupported ? '✓ Real-time Supported' : '✗ Polling Only / None'}<br />
                  {entry.apiDetails}
                </p>
              </div>

              <div class="spec-cell">
                <span class="spec-label">
                  Data Portability & Part 11 Audit 
                  <span class="spec-score-tag">{entry.scoreBreakdown.dataPortability + entry.scoreBreakdown.part11Audit}/30 pts</span>
                </span>
                <p class="spec-val">
                  <strong>Export:</strong> {entry.dataPortability}<br />
                  <strong>Attribution:</strong> {entry.part11AiAttribution}<br />
                  <strong>ISO 42001:</strong> {entry.iso42001Status}
                </p>
              </div>

              <div class="spec-cell">
                <span class="spec-label">
                  Commercial Moat & BYO-AI 
                  <span class="spec-score-tag">{entry.scoreBreakdown.byoAiFreedom}/15 pts</span>
                </span>
                <p class="spec-val">
                  <strong>Lock-in Risk:</strong> {entry.commercialMoatRisk}<br />
                  <strong>API Pricing:</strong> {entry.apiPricingPosture}
                </p>
              </div>
            </div>

            <div class="takeaway-card" style="margin-top: 12px;">
              <strong class="takeaway-title">Procurement & Buyer Takeaway:</strong>
              <p class="takeaway-text">{entry.buyerTakeaway}</p>
            </div>

            <div class="card-footer-audit">
              <span>Audited: {entry.lastAudited}</span>
              <div style="display: flex; gap: 12px; align-items: center;">
                <a href={`/vendors/${entry.vendorId}/`} class="vendor-deep-link">
                  Profile &rarr;
                </a>
                {entry.website && (
                  <a href={entry.website} target="_blank" rel="noopener" class="external-link">
                    Official Site ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Empty state -->
  <div id="trackerEmptyState" style="display: none; padding: 40px; text-align: center; background: var(--card-bg); border-radius: 6px; border: 1px dashed #999; margin-top: 20px;">
    <h3 style="font-family: var(--font-serif); margin-bottom: 8px;">No matching vendors found</h3>
    <p style="font-size: 13px; color: var(--muted-text);">Try adjusting your search query, or clear the Walled Garden Posture and MCP filters.</p>
    <button class="filter-pill" id="trackerResetBtn" type="button" style="margin-top: 14px; background: #000; color: #fff; border-color: #000;">Reset All Filters</button>
  </div>
</div>

<style>
  .ai-tracker-wrapper {
    margin: 20px 0 40px 0;
  }

  /* KPI Grid */
  .tracker-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
  }

  .kpi-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 14px 16px;
  }

  .kpi-label {
    font-size: 11px;
    color: var(--muted-text);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .kpi-value {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 2px;
  }

  .kpi-sub {
    font-size: 11px;
    color: var(--muted-text);
  }

  .kpi-success .kpi-value {
    color: #1b5e20;
  }

  .kpi-accent .kpi-value {
    color: #0d47a1;
  }

  .kpi-warning .kpi-value {
    color: #b71c1c;
  }

  /* Toolbar */
  .tracker-toolbar {
    background: #fdfdfc;
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 16px;
    margin-bottom: 20px;
  }

  .search-row {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .search-row .search-input {
    flex: 1;
    min-width: 260px;
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    border: 1px solid #00000026;
    border-radius: 4px;
    background: #fff;
    outline: none;
  }

  .search-row .search-input:focus {
    border-color: #000;
  }

  .view-switchers {
    display: flex;
    gap: 6px;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    border: 1px solid #00000022;
    background: #fff;
    cursor: pointer;
    border-radius: 4px;
    color: var(--text-color);
  }

  .view-btn.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .filter-group-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .group-label {
    font-size: 11.5px;
    color: var(--muted-text);
    font-weight: 500;
    min-width: 170px;
  }

  .pill-group {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    flex: 1;
  }

  .filter-pill {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 4px 10px;
    background: #fff;
    border: 1px solid #00000022;
    border-radius: 20px;
    cursor: pointer;
    color: var(--text-color);
    transition: all 0.15s ease;
  }

  .filter-pill:hover {
    border-color: #00000066;
  }

  .filter-pill.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .sort-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .sort-label {
    font-size: 11.5px;
