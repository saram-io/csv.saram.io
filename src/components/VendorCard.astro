---
import type { Vendor } from '../data/vendors';

interface Props {
  vendor: Vendor;
}

const { vendor } = Astro.props;

const tierBadgeClass = 
  vendor.tier === 1 ? 'badge-tier1' :
  vendor.tier === 2 ? 'badge-tier2' :
  vendor.tier === 3 ? 'badge-tier3' : 'badge-tier4';

const priceBadgeClass = 
  vendor.priceTransparency.rating === 'Transparent' ? 'badge-price-transparent' :
  vendor.priceTransparency.rating === 'Moderate' ? 'badge-price-moderate' :
  vendor.priceTransparency.rating === 'Opaque' ? 'badge-price-opaque' : 'badge-price-custom';

const priceRatingKey = 
  vendor.priceTransparency.rating === 'Transparent' ? 'transparent' :
  vendor.priceTransparency.rating === 'Moderate' ? 'moderate' :
  vendor.priceTransparency.rating === 'Opaque' ? 'opaque' : 'other';
---

<div class="card" data-tier={vendor.tier} data-category={vendor.category} data-price-transparency={priceRatingKey} data-name={vendor.name.toLowerCase()} data-search={`${vendor.name} ${vendor.product} ${vendor.summary} ${vendor.priceTransparency.rating} ${vendor.priceTransparency.model} ${vendor.priceTransparency.details} ${vendor.knownCustomers?.join(' ') || ''}`.toLowerCase()}>
  <div class="card-header">
    <div>
      <h3 class="card-title">
        <a href={`/vendors/${vendor.id}/`} style="color: inherit; text-decoration: underline; text-underline-offset: 4px;">
          {vendor.name}
        </a>
      </h3>
      <div class="card-subtitle">{vendor.product}</div>
    </div>
    <span class={`badge ${tierBadgeClass}`}>T{vendor.tier}</span>
  </div>

  <div class="card-body">
    <p>{vendor.summary}</p>
    
    <div style="margin: 10px 0; display: flex; flex-wrap: wrap; gap: 4px; align-items: center;">
      <span class="badge">{vendor.category}</span>
      {vendor.aiReadiness && (
        <span class="badge badge-ai">AI: {vendor.aiReadiness}</span>
      )}
      <span class={`badge ${priceBadgeClass}`}>
        Price: {vendor.priceTransparency.rating} ({vendor.priceTransparency.score}/5)
      </span>
    </div>

    {vendor.aiFeatures && (
      <div style="font-size: 12px; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 4px; margin: 8px 0; border-left: 2px solid #333;">
        <strong>AI Integration:</strong> {vendor.aiFeatures}
      </div>
    )}

    <div class="card-meta" style="margin-top: 6px; font-size: 11.5px; color: var(--muted-text);">
      <strong>Pricing Model:</strong> {vendor.priceTransparency.model} ({vendor.priceTransparency.estimatedRange})
    </div>

    {vendor.knownCustomers && vendor.knownCustomers.length > 0 && (
      <div class="card-meta" style="margin-top: 6px;">
        <strong>Customers:</strong> {vendor.knownCustomers.join(', ')}
      </div>
    )}
  </div>

  <div class="card-footer">
    <div class="card-meta">
      <strong>Status:</strong> {vendor.status2026}
    </div>
    <div class="card-meta">
      <strong>Ownership:</strong> {vendor.ownership}
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; flex-wrap: wrap; gap: 8px;">
      <a href={`/vendors/${vendor.id}/`} class="service-link" style="font-size: 12px; font-weight: 600;">
        Full Platform Profile &rarr;
      </a>
      <div style="display: flex; gap: 10px; align-items: center;">
        {vendor.website && (
          <a href={vendor.website} target="_blank" rel="noopener" class="service-link" style="font-size: 11.5px; opacity: 0.8;">
            External site &rarr;
          </a>
        )}
        <a href="/ai-readiness-tracker" class="service-link" style="font-size: 11.5px; color: var(--muted-text);">
          AI Tracker &rarr;
        </a>
      </div>
    </div>
  </div>
</div>
