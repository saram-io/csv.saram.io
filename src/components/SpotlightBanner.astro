---
interface Props {
  tag?: string;
  title?: string;
  description?: string;
  href?: string;
  ctaText?: string;
}

const {
  tag = "Industry Intelligence • 2026",
  title = "CSV/CSA Validation Vendor Landscape",
  description = "Thoma Bravo acquires Kneat, ValGenesis launches VAL™ agentic AI at INTERPHEX, and Veeva announces Vault MCP Server GA 26R2.",
  href = "/ai-trends",
  ctaText = "Read 2026 Market Analysis"
} = Astro.props;
---

<a href={href} class="gxpchat-banner">
  <div class="gxpchat-icon-container">
    <svg class="gxpchat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
      <circle cx="12" cy="12" r="4"></circle>
    </svg>
  </div>
  <div class="gxpchat-content">
    <div class="gxpchat-title-row">
      <h2 class="gxpchat-title">{title}</h2>
      <span class="gxpchat-tag">&bull; {tag}</span>
    </div>
    <p class="gxpchat-desc">{description}</p>
  </div>
  <span class="gxpchat-cta">{ctaText} <span class="gxpchat-cta-arrow">&rarr;</span></span>
</a>
